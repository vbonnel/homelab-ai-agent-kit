---
/**
 * agent-kit: managed file. `kit docs upgrade` replaces it with the kit's newest version;
 * delete this line to keep your own version instead.
 *
 * Top bar, on the right: Starlight's own social links (`social:` in astro.config.mjs, if any),
 * then the "Export" button. It downloads the whole documentation as one Markdown file (every
 * page of the sidebar, in its order), to upload into an AI tool's project as context. The pages
 * are their Markdown versions (src/pages/[...slug].md.ts), put together in the browser
 * (src/scripts/export-docs.mjs). Label in English, or French on French pages.
 *
 * Set in astro.config.mjs (`components: { SocialIcons: ... }`); Starlight shows it in the top
 * bar, left of the light / dark button, and at the bottom of the phone menu.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { exportList } from '../scripts/export-docs.mjs';

const { sidebar, lang, siteTitle } = Astro.locals.starlightRoute;
const fr = /^fr\b/i.test(lang ?? '');
const t = fr
	? {
			label: 'Exporter',
			busy: 'Export…',
			failed: 'Échec',
			hint: 'Télécharger toute la documentation en un seul fichier Markdown (pour les IA)',
		}
	: {
			label: 'Export',
			busy: 'Exporting…',
			failed: 'Export failed',
			hint: 'Download the whole documentation as one Markdown file (for AI tools)',
		};
const pages = exportList(sidebar, import.meta.env.BASE_URL);
---

<Default />
{
	pages.length > 0 && (
		<kit-export-docs
			data-pages={JSON.stringify(pages)}
			data-title={siteTitle}
			data-lang={lang}
			data-base={import.meta.env.BASE_URL}
		>
			<button type="button" class="kit-export" title={t.hint} data-state="idle">
				<svg class="kit-export-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
				<span class="kit-export-stack">
					<span data-when="idle">{t.label}</span>
					<span data-when="busy">{t.busy}</span>
					<span data-when="failed">{t.failed}</span>
				</span>
			</button>
			<span class="sr-only" role="status" data-busy={t.busy} data-failed={t.failed}></span>
		</kit-export-docs>
	)
}

<script>
	import { exportFileName, exportMarkdown, today } from '../scripts/export-docs.mjs';

	type Page = { label: string; href: string; md: string };

	class KitExportDocs extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const status = this.querySelector<HTMLElement>('[role="status"]')!;
			let reset: ReturnType<typeof setTimeout> | undefined;
			const show = (state: 'idle' | 'busy' | 'failed') => {
				button.dataset.state = state;
				status.textContent = state === 'idle' ? '' : status.dataset[state]!;
			};
			button.addEventListener('click', async () => {
				if (button.dataset.state === 'busy') return;
				clearTimeout(reset);
				show('busy');
				const pages: Page[] = JSON.parse(this.dataset.pages || '[]');
				// Every page at once; a page that can't be read is left out
				const texts = await Promise.all(
					pages.map((p) =>
						fetch(p.md)
							.then((r) => (r.ok ? r.text() : ''))
							.catch(() => ''),
					),
				);
				const found = pages.map((p, i) => ({ ...p, text: texts[i] })).filter((p) => p.text.trim());
				if (!found.length) {
					show('failed');
					reset = setTimeout(() => show('idle'), 2000);
					return;
				}
				const base = (this.dataset.base || '/').replace(/\/+$/, '');
				const text = exportMarkdown({
					title: this.dataset.title || document.title,
					address: location.origin + base,
					date: today(),
					lang: this.dataset.lang || '',
					pages: found,
				});
				// A download link works on plain HTTP too (sites on the local network)
				const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown;charset=utf-8' }));
				const link = document.createElement('a');
				link.href = url;
				link.download = exportFileName(this.dataset.title || '');
				document.body.append(link);
				link.click();
				link.remove();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
				show('idle');
			});
		}
	}
	customElements.define('kit-export-docs', KitExportDocs);
</script>

<style>
	kit-export-docs {
		display: inline-flex;
	}
	.kit-export {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		height: 2.25rem;
		padding: 0 0.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		white-space: nowrap;
		cursor: pointer;
	}
	.kit-export:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.kit-export:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.kit-export[data-state='busy'] {
		cursor: progress;
	}
	.kit-export-icon {
		width: 1rem;
		height: 1rem;
		flex: none;
	}
	/* Its three labels in one cell, only the one of its state shown (and read by screen readers):
	   the width never changes */
	.kit-export-stack {
		display: inline-grid;
	}
	.kit-export-stack > span {
		grid-area: 1 / 1;
	}
	.kit-export:not([data-state='idle']) [data-when='idle'],
	.kit-export:not([data-state='busy']) [data-when='busy'],
	.kit-export:not([data-state='failed']) [data-when='failed'] {
		visibility: hidden;
	}
</style>
