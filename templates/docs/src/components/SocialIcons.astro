---
/**
 * agent-kit: managed file. `kit docs upgrade` replaces it with the kit's newest version;
 * delete this line to keep your own version instead.
 *
 * Top bar, on the right: Starlight's own social links (`social:` in astro.config.mjs, if any),
 * then the "Export docs" button. It downloads the whole documentation as one Markdown file
 * (every page of the sidebar, in its order), to upload into an AI tool's project as context. The
 * pages are their Markdown versions (src/pages/[...slug].md.ts), put together in the browser
 * (src/scripts/export-docs.mjs). It looks like the "Copy page" button next to the page titles.
 * Labels in English, or French on French pages.
 *
 * Set in astro.config.mjs (`components: { SocialIcons: ... }`); Starlight shows it in the top
 * bar, left of the light / dark button, and at the bottom of the phone menu.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { exportList } from '../scripts/export-docs.mjs';

const { sidebar, lang, siteTitle } = Astro.locals.starlightRoute;
const fr = /^fr\b/i.test(lang ?? '');
const pages = exportList(sidebar, import.meta.env.BASE_URL);
const n = pages.length;
const t = fr
	? {
			label: 'Exporter la doc',
			busy: 'Export…',
			done: 'Téléchargé',
			failed: "Échec de l'export",
			hint: n === 1
				? 'Télécharger la page de la doc en un fichier Markdown, pour les IA'
				: `Télécharger les ${n} pages de la doc en un seul fichier Markdown, pour les IA`,
		}
	: {
			label: 'Export docs',
			busy: 'Exporting…',
			done: 'Downloaded',
			failed: 'Export failed',
			hint: n === 1
				? 'Download the 1 page of the docs as one Markdown file, for AI tools'
				: `Download all ${n} pages of the docs as one Markdown file, for AI tools`,
		};
---

<Default />
{
	n > 0 && (
		<kit-export-docs
			data-pages={JSON.stringify(pages)}
			data-title={siteTitle}
			data-lang={lang}
			data-base={import.meta.env.BASE_URL}
		>
			<button type="button" class="kit-export" title={t.hint} data-state="idle">
				<span class="kit-export-stack" aria-hidden="true">
					<svg data-when="idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M12 11v6M9 14l3 3 3-3" /></svg>
					<svg data-when="busy" class="kit-export-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" opacity="0.25" /><path d="M20.5 12A8.5 8.5 0 0 0 12 3.5" /></svg>
					<svg data-when="done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
					<svg data-when="failed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
				</span>
				<span class="kit-export-stack">
					<span data-when="idle">{t.label}</span>
					<span data-when="busy">{t.busy}</span>
					<span data-when="done">{t.done}</span>
					<span data-when="failed">{t.failed}</span>
				</span>
				<span class="kit-export-tag" aria-hidden="true">.md</span>
			</button>
			<span class="sr-only" role="status" data-busy={t.busy} data-done={t.done} data-failed={t.failed}></span>
		</kit-export-docs>
	)
}

<script>
	import { exportFileName, exportMarkdown, today } from '../scripts/export-docs.mjs';

	type Page = { label: string; href: string; md: string };
	type State = 'idle' | 'busy' | 'done' | 'failed';

	class KitExportDocs extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const status = this.querySelector<HTMLElement>('[role="status"]')!;
			let reset: ReturnType<typeof setTimeout> | undefined;
			// The button shows the label and icon of its state (CSS); the status line tells screen readers
			const show = (state: State) => {
				button.dataset.state = state;
				status.textContent = state === 'idle' ? '' : status.dataset[state]!;
				clearTimeout(reset);
				if (state === 'done' || state === 'failed') reset = setTimeout(() => show('idle'), 2000);
			};
			button.addEventListener('click', async () => {
				if (button.dataset.state === 'busy') return;
				show('busy');
				const pages: Page[] = JSON.parse(this.dataset.pages || '[]');
				// Every page at once; a page that can't be read is left out
				const texts = await Promise.all(
					pages.map((p) =>
						fetch(p.md)
							.then((r) => (r.ok ? r.text() : ''))
							.catch(() => ''),
					),
				);
				const found = pages.map((p, i) => ({ ...p, text: texts[i] })).filter((p) => p.text.trim());
				if (!found.length) {
					show('failed');
					return;
				}
				const base = (this.dataset.base || '/').replace(/\/+$/, '');
				const text = exportMarkdown({
					title: this.dataset.title || document.title,
					address: location.origin + base,
					date: today(),
					lang: this.dataset.lang || '',
					pages: found,
				});
				// A download link works on plain HTTP too (sites on the local network)
				const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown;charset=utf-8' }));
				const link = document.createElement('a');
				link.href = url;
				link.download = exportFileName(this.dataset.title || '');
				document.body.append(link);
				link.click();
				link.remove();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
				show('done');
			});
		}
	}
	customElements.define('kit-export-docs', KitExportDocs);
</script>

<style>
	kit-export-docs {
		display: inline-flex;
	}
	/* Same look as the "Copy page" button (components/PageActions.astro) */
	.kit-export {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.25rem;
		padding: 0 0.5rem 0 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
	}
	.kit-export:hover {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.kit-export:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.kit-export[data-state='busy'] {
		cursor: progress;
	}
	.kit-export[data-state='done'] {
		color: var(--sl-color-text-accent);
	}
	.kit-export svg {
		width: 1rem;
		height: 1rem;
	}
	/* The file format, in a small grey tag */
	.kit-export-tag {
		padding: 0.05rem 0.375rem;
		border-radius: 0.375rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-system-mono);
		font-size: 0.75rem;
		font-weight: 400;
		line-height: 1.4;
	}
	.kit-export:hover .kit-export-tag {
		background: var(--sl-color-gray-5);
		color: var(--sl-color-gray-2);
	}
	/* Each state's label and icon in one grid cell: the widest sets the width, which never changes;
	   only the one of the button's state is shown (and read by screen readers) */
	.kit-export-stack {
		display: inline-grid;
		align-items: center;
	}
	.kit-export-stack > * {
		grid-area: 1 / 1;
		visibility: hidden;
	}
	.kit-export[data-state='idle'] [data-when='idle'],
	.kit-export[data-state='busy'] [data-when='busy'],
	.kit-export[data-state='done'] [data-when='done'],
	.kit-export[data-state='failed'] [data-when='failed'] {
		visibility: visible;
	}
	.kit-export-spin {
		animation: kit-export-turn 0.8s linear infinite;
	}
	@keyframes kit-export-turn {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.kit-export-spin {
			animation: none;
		}
	}
</style>
