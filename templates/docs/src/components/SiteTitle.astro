---
/**
 * agent-kit: managed file. `kit docs upgrade` replaces it with the kit's newest version;
 * delete this line to keep your own version instead.
 *
 * Site title in the top bar, with the docs version next to it in a small pill.
 *
 * Set in astro.config.mjs (`components: { SiteTitle: ... }`): Starlight's own title, then
 * the short id of the save the website was built from (src/version.mjs). The pill links to
 * the changelog; its hover text gives the save date. Two sites (or a mirror) showing the
 * same pill serve the same copy.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { docsVersion } from '../version.mjs';

const { id, saved } = docsVersion();
const label = id || 'unknown';
const hint = id
	? `Docs version ${id}, saved ${saved}. Click for the changelog.`
	: 'Docs version unknown (no save history when the website was built). Click for the changelog.';
---

<span class="title-with-version">
	<Default />
	<a href="/changelog/" class="docs-version" title={hint} aria-label={hint} translate="no">
		{label}
	</a>
</span>

<style>
	.title-with-version {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}
	.docs-version {
		/* Always fully visible: on a narrow screen the title is cut first */
		flex-shrink: 0;
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.4;
		text-decoration: none;
		white-space: nowrap;
	}
	.docs-version:hover {
		border-color: var(--sl-color-text-accent);
	}
</style>
